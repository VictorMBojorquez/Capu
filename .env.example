# Copia este archivo como .env y llena los valores de tu cliente de Google Cloud.
# Guía completa: docs/guia-conexion-classroom.md

GOOGLE_CLIENT_ID=##############.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=##############

# Opcionales (valores por defecto razonables):
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# CAPU_SYNC_MINUTOS=15
# PORT=3000
# CAPU_DB=database/capu.db
# CAPU_FIXED_NOW=
