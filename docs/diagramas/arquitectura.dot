digraph G {
  rankdir=LR; bgcolor="white"; nodesep=0.5; ranksep=0.7;
  node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=13, color="#5E7676", penwidth=1.5, margin="0.2,0.12"];
  edge [color="#5E7676", fontname="Liberation Sans", fontsize=11, penwidth=1.3];
  subgraph cluster_c { label="Cliente"; fontname="Liberation Sans"; fontsize=14; color="#F4C06E"; style="rounded";
    app [label="Interfaz web CAPU\n(HTML / CSS / JavaScript)", fillcolor="#FFE9CC"]; }
  subgraph cluster_s { label="Servidor CAPU (Node.js + Express)"; fontname="Liberation Sans"; fontsize=14; color="#E67E3F"; style="rounded";
    api [label="API REST\n(app.js)", fillcolor="#FFD9B8"];
    int [label="Capa de integración\n(adaptadores mock / Google)", fillcolor="#FFD9B8"];
    rec [label="Servicio de\nrecordatorios", fillcolor="#FFD9B8"];
    gam [label="Servicio de tokens\n(gamificación)", fillcolor="#FFD9B8"];
    db [label="SQLite\n(PostgreSQL en producción)", shape=cylinder, fillcolor="#DCE7E7"]; }
  subgraph cluster_e { label="Servicios externos"; fontname="Liberation Sans"; fontsize=14; color="#7A9090"; style="rounded";
    gc [label="Google Classroom API", fillcolor="#DCE7E7"];
    oa [label="Google OAuth 2.0\n(Etapa III)", fillcolor="#DCE7E7", style="rounded,filled,dashed"];
    push [label="Web Push / correo\n(Etapa III)", fillcolor="#DCE7E7", style="rounded,filled,dashed"]; }
  app -> api [label="HTTPS / JSON"];
  api -> int; api -> gam; api -> db; rec -> db; gam -> db;
  int -> gc [label="sincroniza"]; api -> oa [label="login", style=dashed];
  rec -> push [label="envía", style=dashed];
}
