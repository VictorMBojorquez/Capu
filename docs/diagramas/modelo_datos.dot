digraph ER {
rankdir=LR; bgcolor=white; nodesep=0.5; ranksep=1.0;
node [shape=plaintext, fontname="Liberation Sans", fontsize=11];
edge [color="#5E7676", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3];
USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#E67E3F"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_usuario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">google_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">correo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">saldo_tokens</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">racha_dias</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">ultima_entrega_ok</TD></TR></TABLE>>];
CURSO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>CURSO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_curso</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_usuario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">classroom_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR></TABLE>>];
TAREA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>TAREA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_tarea</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_curso</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">classroom_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">titulo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">descripcion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_limite</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">estado</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">avance_pct</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_entrega</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">enlace</TD></TR></TABLE>>];
RECORDATORIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>RECORDATORIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_recordatorio</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_tarea</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_hora</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">canal</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">enviado</TD></TR></TABLE>>];
TRANSACCION_TOKEN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>TRANSACCION_TOKEN</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_transaccion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_usuario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_tarea</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">cantidad</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">motivo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha</TD></TR></TABLE>>];
RECOMPENSA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>RECOMPENSA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_recompensa</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">costo_tokens</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">activa</TD></TR></TABLE>>];
CANJE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E7676"><TR><TD BGCOLOR="#7A9090"><FONT COLOR="white"><B>CANJE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3E3">PK id_canje</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_usuario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">FK id_recompensa</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha</TD></TR></TABLE>>];
USUARIO -> CURSO;
CURSO -> TAREA;
TAREA -> RECORDATORIO;
USUARIO -> TRANSACCION_TOKEN;
TAREA -> TRANSACCION_TOKEN;
USUARIO -> CANJE;
RECOMPENSA -> CANJE;
}